<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TheOasis.Client.GamePage"
             BackgroundColor="#0f0f0f"
             NavigationPage.HasBackButton="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="30">

        <Label Text="IDENTITY REVEAL" 
               TextColor="#666" 
               HorizontalOptions="Center" 
               CharacterSpacing="2"
               Margin="0,20,0,0"/>

        <Border Grid.Row="1" 
                x:Name="CardBorder"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="#1a1a1a"
                Stroke="{Binding FactionColor}"
                StrokeThickness="3"
                Padding="20"
                VerticalOptions="Center"
                HeightRequest="400">

            <VerticalStackLayout Spacing="15" VerticalOptions="Center">

                <Label Text="{Binding FactionName}" 
                       TextColor="{Binding FactionColor}" 
                       FontSize="18" 
                       HorizontalOptions="Center" 
                       FontAttributes="Bold"/>

                <Label Text="{Binding RoleName}" 
                       TextColor="White" 
                       FontSize="36" 
                       HorizontalOptions="Center" 
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>

                <BoxView HeightRequest="1" Color="#333" WidthRequest="100"/>

                <Label Text="{Binding Description}" 
                       TextColor="#ccc" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center"
                       FontSize="14"/>

                <Border StrokeShape="RoundRectangle 5" 
                        Stroke="Transparent"
                        BackgroundColor="#222" 
                        Padding="10" 
                        Margin="0,20,0,0" 
                        IsVisible="{Binding HasSecretInfo}">
                    <Label Text="{Binding SecretInfo}" 
                           TextColor="#F59E0B" 
                           FontSize="12" 
                           HorizontalTextAlignment="Center"/>
                </Border>
            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="2"
                Text="PROCEED TO MISSION"
                BackgroundColor="#333"
                TextColor="White"
                Margin="0,0,0,20"/>
    </Grid>
</ContentPage>