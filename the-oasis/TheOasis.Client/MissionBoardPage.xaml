<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TheOasis.Client.MissionBoardPage"
             BackgroundColor="#1a1a1a"
             NavigationPage.HasBackButton="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15">

        <Border Grid.Row="0" StrokeShape="RoundRectangle 5" BackgroundColor="#111" Stroke="#333" Padding="10" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="👤" TextColor="#888"/>
                    <Label x:Name="MyNickLabel" Text="Nickname" TextColor="White" FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="🎭" TextColor="#888"/>
                    <Label x:Name="MyRoleLabel" Text="Role Name" TextColor="#F59E0B" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,15">
            <Button Grid.Column="0"
                    x:Name="TabBoardBtn" 
                    Text="GAME BOARD" 
                    Clicked="OnTabBoardClicked"
                    BackgroundColor="#F59E0B" 
                    TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="5"
                    Margin="0,0,5,0"/>

            <Button Grid.Column="1"
                    x:Name="TabHistoryBtn" 
                    Text="HISTORY" 
                    Clicked="OnTabHistoryClicked"
                    BackgroundColor="#333" 
                    TextColor="Gray"
                    FontAttributes="Bold"
                    CornerRadius="5"
                    Margin="5,0,0,0"/>
        </Grid>

        <Grid x:Name="BoardView" Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto, Auto, *, Auto" IsVisible="True">

            <VerticalStackLayout Grid.Row="0" Spacing="5">
                <Label x:Name="SystemMessageLabel" Text="Waiting..." TextColor="#F59E0B" HorizontalOptions="Center" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Grid ColumnDefinitions="*, *">
                    <Label x:Name="MissionInfoLabel" Text="Mission 1" TextColor="White"/>
                    <Label x:Name="VoteTrackLabel" Text="Failed Votes: 0/5" TextColor="#ef4444" HorizontalOptions="End"/>
                </Grid>
                <CollectionView x:Name="VoteTrackView" HeightRequest="20" HorizontalOptions="End">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="{Binding Color}" WidthRequest="15" HeightRequest="15" StrokeThickness="0"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <BoxView Grid.Row="1" HeightRequest="1" Color="#333" Margin="0,10"/>

            <CollectionView x:Name="PlayersCollection" Grid.Row="2" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#2d3e50" Margin="0,5" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlayerTapped" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="30, *, Auto, Auto">
                                <Label Text="👑" IsVisible="{Binding IsLeader}" VerticalOptions="Center"/>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="12"/>
                                </VerticalStackLayout>

                                <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" IsVisible="{Binding IsSelectionMode}" InputTransparent="True" Color="#4ade80"/>

                                <Button Grid.Column="3"
                                        Text="🎯"
                                        BackgroundColor="#ef4444"
                                        TextColor="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        CornerRadius="20"
                                        IsVisible="{Binding IsTargetable}"
                                        Clicked="OnShootClicked"
                                        CommandParameter="{Binding Name}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="3" Spacing="10" Margin="0,10,0,0">

                <Button x:Name="ConfirmTeamBtn" Text="CONFIRM TEAM" Clicked="OnConfirmTeamClicked" BackgroundColor="#4ade80" TextColor="Black" IsVisible="False"/>

                <Grid x:Name="VotingControls" ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="False">
                    <Button Grid.Column="0" Text="APPROVE" Clicked="OnVoteApprove" BackgroundColor="#4ade80" TextColor="Black"/>
                    <Button Grid.Column="1" Text="REJECT" Clicked="OnVoteReject" BackgroundColor="#ef4444" TextColor="White"/>
                </Grid>

                <Grid x:Name="MissionControls" ColumnDefinitions="*,*,*" ColumnSpacing="5" IsVisible="False">
                    <Button Grid.Column="0" Text="SUCCESS" Clicked="OnMissionSuccess" BackgroundColor="#4ade80" TextColor="Black"/>
                    <Button Grid.Column="1" Text="FAIL" x:Name="BtnFail" Clicked="OnMissionFail" BackgroundColor="#ef4444" TextColor="White"/>
                    <Button Grid.Column="2" Text="REVERSE" x:Name="BtnReverse" Clicked="OnMissionReverse" BackgroundColor="#3b82f6" TextColor="White"/>
                </Grid>

                <Button x:Name="PlayAgainBtn" 
                        Text="PLAY AGAIN" 
                        Clicked="OnPlayAgainClicked" 
                        BackgroundColor="#F59E0B" 
                        TextColor="Black" 
                        FontAttributes="Bold"
                        IsVisible="False"/>

            </VerticalStackLayout>
        </Grid>

        <CollectionView x:Name="HistoryCollection" 
                        Grid.Row="2" 
                        Grid.RowSpan="2" 
                        IsVisible="False"
                        Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10" 
                            BackgroundColor="#222" 
                            Stroke="{Binding BorderColor}"
                            StrokeThickness="2"
                            Margin="0,0,0,15" 
                            Padding="15">

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="16"/>
                                <Label Grid.Column="1" Text="{Binding ResultText}" TextColor="{Binding ResultColor}" FontAttributes="Bold"/>
                            </Grid>

                            <Label Text="{Binding TeamString}" TextColor="#BBB" FontSize="12" FontAttributes="Italic"/>

                            <BoxView HeightRequest="1" Color="#444"/>

                            <Label Text="Votes:" TextColor="Gray" FontSize="10"/>
                            <FlexLayout BindableLayout.ItemsSource="{Binding VotesDetail}" Wrap="Wrap" Direction="Row">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#333" StrokeShape="RoundRectangle 5" Padding="5,2" Margin="0,0,5,5" StrokeThickness="0">
                                            <Label Text="{Binding .}" TextColor="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Label Text="{Binding OutcomeString}" 
                                   TextColor="#F59E0B" 
                                   FontSize="14" 
                                   IsVisible="{Binding HasOutcome}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>