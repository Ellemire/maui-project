<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TheOasis.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TheOasis.Client"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Secondary.Light}, Dark={StaticResource Secondary.Dark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource OnSecondary.Light}, Dark={StaticResource OnSecondary.Dark}}"
    Title="TheOasis.Client">

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
