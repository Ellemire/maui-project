<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TheOasis.Client.MainPage"
             BackgroundColor="#1a1a1a">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="THE OASIS" 
               FontSize="32" 
               TextColor="White" 
               HorizontalOptions="Center" 
               FontAttributes="Bold"/>

        <Entry x:Name="NickEntry"
               Placeholder="Enter your nickname"
               HorizontalTextAlignment="Center"
               TextColor="Black"
               BackgroundColor="White"
               HeightRequest="50"
               WidthRequest="250"
               MaxLength="12"/>

        <Entry x:Name="CodeEntry"
               Placeholder="Code (6 digits)"
               MaxLength="6"
               Keyboard="Numeric"
               HorizontalTextAlignment="Center"
               TextColor="Black"
               BackgroundColor="White"
               HeightRequest="50"
               WidthRequest="250"
               CharacterSpacing="5"/>

        <Button Text="Join Game"
                Clicked="OnJoinClicked"
                BackgroundColor="#3e4c59"
                TextColor="White"
                CornerRadius="8"/>

        <Button Text="Create Game"
                Clicked="OnCreateClicked"
                BackgroundColor="#2d3e50"
                TextColor="#4ade80" 
                BorderColor="#4ade80"
                BorderWidth="1"
                CornerRadius="8"
                Margin="0,20,0,0"/>

    </VerticalStackLayout>
</ContentPage>